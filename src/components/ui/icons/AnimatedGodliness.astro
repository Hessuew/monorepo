---
interface Props {
  animate?: boolean;
  classes?: string;
  stroke?: string;
  strokeWidth?: number;
  delay?: number;
  gradientFrom?: string;
  gradientTo?: string;
  gradientId?: string;
}

const {
  animate = true,
  classes= '',
  stroke = 'currentColor',
  strokeWidth = 20,
  delay = 0,
  gradientId = 'godlinessGradient',
  gradientFrom = '#1a0024',
  gradientTo = 'rgba(255, 170, 64)',
} = Astro.props;

// Determine Tailwind color class
const strokeClass = stroke.startsWith('text-') ? stroke : '';

---
<div class={animate ? 'wave-wrapper6' : 'static-wrapper6'}>
  <svg 
    class={`curvy-wave ${classes} ${strokeClass}`} 
    viewBox='0 0 256 256'
    xmlns="http://www.w3.org/2000/svg"
  >
      <defs>
        <linearGradient id={gradientId} x1='0' y1='0' x2='1' y2='1'>
          <stop offset='10%' stop-color={gradientFrom} />
          <stop offset='100%' stop-color={gradientTo} />
        </linearGradient>
      </defs>
      <circle cx="128" cy="128" r="20"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={40} 
        stroke-linecap="round"
        class={animate ? 'wave-path6' : 'static-path6'}
        style={animate ? `
        stroke-dasharray: 400;
        stroke-dashoffset: 400;
        animation-delay: ${delay}ms;
      ` : ''}
      />
      <path 
        d="M111.1 195.4c1.1-3.1-.6-6.5-3.7-7.6s-6.5.6-7.6 3.7.6 6.6 3.7 7.6c.6.2 1.3.3 2 .3 2.4 0 4.7-1.5 5.6-4M77.6 80.3c-2.6-2.1-6.4-1.6-8.4 1-2.1 2.6-1.6 6.4 1 8.4 1.1.9 2.4 1.3 3.7 1.3 1.8 0 3.5-.8 4.7-2.3 2-2.6 1.6-6.3-1-8.4M151 69c.7.3 1.4.4 2.2.4 2.4 0 4.7-1.4 5.6-3.8 1.2-3.1-.3-6.6-3.4-7.8s-6.6.3-7.8 3.4.3 6.6 3.4 7.8m-83.4 93.2c-2.7 1.9-3.4 5.6-1.5 8.4 1.2 1.7 3 2.6 5 2.6 1.2 0 2.4-.3 3.4-1 2.7-1.9 3.4-5.6 1.5-8.3-1.9-2.9-5.6-3.6-8.4-1.7m79.3 26.2c-3.2 1-4.9 4.3-4 7.5.8 2.6 3.2 4.2 5.7 4.2q.9 0 1.8-.3c3.2-1 4.9-4.3 4-7.5-1-3.1-4.4-4.8-7.5-3.9M110 67.2c.5 0 1.1-.1 1.6-.2 3.2-.9 5.1-4.2 4.2-7.4s-4.2-5.1-7.4-4.2-5.1 4.2-4.2 7.4c.7 2.6 3.1 4.4 5.8 4.4"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={strokeWidth} 
        stroke-linecap="round"
        class={animate ? 'wave-path6' : 'static-path6'}
        style={animate ? `
        stroke-dasharray: 40;
        stroke-dashoffset: 40;
        animation-delay: ${delay}ms;
      ` : ''}
      />
      <circle cx="197.4" cy="128" r="6"
        fill="none"
        stroke="rgba(255, 170, 64, 0.7)"
        stroke-width={strokeWidth} 
        stroke-linecap="round"
        class={animate ? 'wave-path6' : 'static-path6'}
        style={animate ? `
        stroke-dasharray: 40;
        stroke-dashoffset: 40;
        animation-delay: ${delay}ms;
      ` : ''}
      />
      <path 
        d="M187.5 164.3c-2.7-2-6.4-1.4-8.4 1.3s-1.4 6.4 1.3 8.4q1.65 1.2 3.6 1.2c1.8 0 3.7-.9 4.8-2.4 1.9-2.8 1.3-6.6-1.3-8.5M59.2 119.6c-3.3-.1-6.1 2.5-6.2 5.8s2.5 6.1 5.8 6.2h.2c3.2 0 5.9-2.5 6-5.8s-2.5-6.1-5.8-6.2m132.5-32a5.99 5.99 0 0 0-8.3-1.8 5.99 5.99 0 0 0-1.8 8.3c1.1 1.8 3.1 2.8 5.1 2.8 1.1 0 2.2-.3 3.2-.9 2.7-1.9 3.6-5.6 1.8-8.4m34.4 96.2c-2.8-1.8-6.5-1-8.3 1.8s-1 6.5 1.8 8.3c1 .7 2.1 1 3.2 1 2 0 3.9-1 5.1-2.8 1.8-2.8 1-6.6-1.8-8.3M222.7 73c1.1 0 2.2-.3 3.3-1 2.8-1.8 3.6-5.5 1.8-8.3a5.99 5.99 0 0 0-8.3-1.8 5.99 5.99 0 0 0-1.8 8.3c1.1 1.8 3 2.8 5 2.8m17.9 48.8c-3.3 0-6 2.7-6 6v.3c0 3.3 2.7 6 6 6s6-2.7 6-6v-.2c0-3.5-2.6-6.1-6-6.1M172.2 31c.8.4 1.6.5 2.5.5 2.3 0 4.5-1.3 5.5-3.5 1.4-3 0-6.6-3-8s-6.6 0-7.9 3c-1.4 3.1-.1 6.6 2.9 8M54.4 49.1c1.4 0 2.8-.5 3.9-1.5 2.5-2.2 2.8-6 .6-8.5s-6-2.8-8.5-.6-2.8 6-.6 8.5c1.2 1.4 2.9 2.1 4.6 2.1M18.5 154c-3.2.9-5 4.3-4.1 7.5.8 2.6 3.2 4.3 5.8 4.3.6 0 1.1-.1 1.7-.2 3.2-.9 5-4.3 4.1-7.5-1-3.2-4.3-5-7.5-4.1m40 54.5c-2.5-2.2-6.3-1.9-8.5.6s-1.9 6.3.6 8.5c1.1 1 2.5 1.5 3.9 1.5 1.7 0 3.3-.7 4.5-2.1 2.3-2.5 2-6.3-.5-8.5m54.6 24.9c-3.3-.5-6.3 1.8-6.8 5.1s1.8 6.3 5.1 6.8c.3 0 .6.1.9.1 2.9 0 5.5-2.2 5.9-5.2.4-3.3-1.9-6.3-5.1-6.8M18.5 102.2c.6.2 1.1.2 1.7.2 2.6 0 5-1.7 5.8-4.3.9-3.2-.9-6.5-4.1-7.4s-6.5.9-7.4 4.1c-1 3.1.8 6.5 4 7.4m154 122.7c-3 1.4-4.3 4.9-3 8 1 2.2 3.2 3.5 5.5 3.5.8 0 1.7-.2 2.5-.5 3-1.4 4.3-4.9 3-8-1.5-3.1-5-4.4-8-3M112 22.7c.3 0 .6 0 .9-.1 3.3-.5 5.6-3.5 5.1-6.8s-3.5-5.6-6.8-5.1-5.6 3.5-5.1 6.8c.4 3 2.9 5.2 5.9 5.2"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={strokeWidth} 
        stroke-linecap="round"
        class={animate ? 'wave-path6' : 'static-path6'}
        style={animate ? `
        stroke-dasharray: 400;
        stroke-dashoffset: 400;
        animation-delay: ${delay}ms;
      ` : ''}
      />
  </svg>

  {animate && (
    <>
      <style is:inline>
        .wave-wrapper6 {
          position: relative;
          width: 100%;
          height: 100%;
          align-items: end;
          display: flex;
        }

        .wave-path6 {
          opacity: 0;
        }

        .wave-path6.visible {
          opacity: 1;
          animation: drawWave 12s ease-out forwards;
        }

        @keyframes drawWave {
          to {
            stroke-dashoffset: 0;
          }
        }
      </style>

      <script>
        function setupWaveObserver() {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  entry.target.querySelectorAll('.wave-path6').forEach((el) => el.classList.add('visible'));
                  observer.unobserve(entry.target);
                }
              });
            },
            { 
              threshold: 0.1,
              rootMargin: '50px'
            }
          );

          document.querySelectorAll('.wave-wrapper6').forEach((wrapper) => {
            if (wrapper && !wrapper.classList.contains('visible')) {
              observer.observe(wrapper);
            }
          });
        }

        // Run immediately
        setupWaveObserver();

        // Run again after page load to catch any dynamically loaded elements
        window.addEventListener('load', setupWaveObserver);

        // Run when Astro view transitions complete
        document.addEventListener('astro:page-load', setupWaveObserver);

      </script>
    </>
  )}
</div>

<style is:global>
  .curvy-wave {
    width: 100%;
    height: 100%;
  }

  .static-wrapper6 {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-path6 {
    opacity: 1;
  }
</style>
