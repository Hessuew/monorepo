---
interface Props {
  animate?: boolean;
  classes?: string;
  stroke?: string;
  strokeWidth?: number;
  delay?: number;
  gradientFrom?: string;
  gradientTo?: string;
  gradientId?: string;
}

const {
  animate = true,
  classes= '',
  stroke = 'currentColor',
  strokeWidth = 20,
  delay = 0,
  gradientId = 'treeGradient',
  gradientFrom = '#1a0024',
  gradientTo = 'rgba(255, 170, 64)',
} = Astro.props;

// Determine Tailwind color class
const strokeClass = stroke.startsWith('text-') ? stroke : '';

---
<div class={animate ? 'wave-wrapper5' : 'static-wrapper5'}>
  <svg 
    class={`curvy-wave ${classes} ${strokeClass}`} 
    viewBox='0 -8 390 390'
    xmlns="http://www.w3.org/2000/svg"
  >
      <defs>
        <linearGradient id={gradientId} x1='0' y1='0' x2='1' y2='1'>
          <stop offset='16%' stop-color={gradientFrom} />
          <stop offset='90%' stop-color={gradientTo} />
        </linearGradient>
      </defs>

      <path 
        d="M279.3 231.701c26.775-1.755 48.025-24.083 48.025-51.295 0-26.232-19.751-47.925-45.16-51.024a51.3 51.3 0 0 0 1.558-12.562c0-26.465-20.1-48.317-45.835-51.11a51.3 51.3 0 0 0 2.036-14.292C239.925 23.066 216.859 0 188.507 0s-51.418 23.066-51.418 51.418c0 4.96.72 9.751 2.036 14.292-25.735 2.793-45.835 24.645-45.835 51.11 0 4.333.544 8.539 1.558 12.562-25.409 3.099-45.16 24.792-45.16 51.024 0 27.211 21.25 49.54 48.025 51.295l76.87 68.287v49.026h-29.622c-4.62 0-8.378 3.527-8.378 7.863v12.295c0 4.324 3.758 7.842 8.378 7.842h87.092c4.363 0 7.53-3.298 7.53-7.842v-12.295c0-4.556-3.167-7.863-7.53-7.863h-29.47v-49.161zm-76.717-1.795c12.455-3.497 23.007-11.571 29.722-22.293a51.8 51.8 0 0 0 16.46 16.436l-46.182 41.025zm-74.334-5.856a51.8 51.8 0 0 0 16.656-16.743c6.662 10.806 17.209 18.963 29.678 22.53v35.373z"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={strokeWidth} 
        stroke-linecap="round"
        class={animate ? 'wave-path5' : 'static-path5'}
        style={animate ? `
        stroke-dasharray: 1400;
        stroke-dashoffset: 1400;
        animation-delay: ${delay}ms;
      ` : ''}
      />
  </svg>

  {animate && (
    <>
      <style is:inline>
        .wave-wrapper5 {
          position: relative;
          width: 100%;
          height: 100%;
          align-items: end;
          display: flex;
        }

        .wave-path5 {
          opacity: 0;
        }

        .wave-path5.visible {
          opacity: 1;
          animation: drawWave5 3.4s ease-out forwards;
        }

        @keyframes drawWave5 {
          to {
            stroke-dashoffset: 0;
          }
        }
      </style>

      <script>
        function setupWaveObserver() {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  entry.target.querySelector('.wave-path5')?.classList.add('visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { 
              threshold: 0.1,
              rootMargin: '50px'
            }
          );

          document.querySelectorAll('.wave-wrapper5').forEach((wrapper) => {
            if (wrapper && !wrapper.classList.contains('visible')) {
              observer.observe(wrapper);
            }
          });
        }

        // Run immediately
        setupWaveObserver();

        // Run again after page load to catch any dynamically loaded elements
        window.addEventListener('load', setupWaveObserver);

        // Run when Astro view transitions complete
        document.addEventListener('astro:page-load', setupWaveObserver);

      </script>
    </>
  )}
</div>

<style is:global>
  .curvy-wave {
    width: 100%;
    height: 100%;
  }

  .static-wrapper5 {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-path5 {
    opacity: 1;
  }
</style>
