---
interface Props {
  animate?: boolean;
  classes?: string;
  stroke?: string;
  strokeWidth?: number;
  delay?: number;
  gradientFrom?: string;
  gradientTo?: string;
  gradientId?: string;
}

const {
  animate = true,
  classes= '',
  stroke = 'currentColor',
  strokeWidth = 24,
  delay = 0,
  gradientId = 'treeGradient',
  gradientFrom = '#1a0024',
  gradientTo = 'rgba(255, 170, 64)',
} = Astro.props;

// Determine Tailwind color class
const strokeClass = stroke.startsWith('text-') ? stroke : '';

---
<div class={animate ? 'wave-wrapper5' : 'static-wrapper5'}>
  <svg 
    class={`curvy-wave ${classes} ${strokeClass}`} 
    viewBox='0 -8 532 532'
    xmlns="http://www.w3.org/2000/svg"
  >
      <defs>
        <linearGradient id={gradientId} x1='0' y1='0' x2='1' y2='1'>
          <stop offset='16%' stop-color={gradientFrom} />
          <stop offset='90%' stop-color={gradientTo} />
        </linearGradient>
      </defs>

      <path 
        d="M451.799 116.688a8.52 8.52 0 0 0-8.064-5.751c-96.435 0-164.727 166.903-187.733 302.336-23.006-135.433-91.298-302.336-187.734-302.336a8.52 8.52 0 0 0-8.064 5.751C4.064 279.351 48.966 378.406 80.736 422.975c40.328 56.576 104.209 89.028 175.266 89.028s134.938-32.452 175.266-89.028c31.769-44.569 76.672-143.624 20.531-306.287M195.594 459.472a8.54 8.54 0 0 1-7.893 5.282 8.4 8.4 0 0 1-3.251-.657c-30.549-12.621-56.09-33.126-75.921-60.937-40.013-56.14-50.765-136.353-30.277-225.868 1.05-4.599 5.623-7.484 10.214-6.417a8.536 8.536 0 0 1 6.417 10.223c-19.379 84.702-9.6 160.043 27.546 212.156 17.937 25.156 40.994 43.691 68.54 55.074 4.352 1.8 6.426 6.792 4.625 11.144"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class={animate ? 'wave-path5' : 'static-path5'}
        style={animate ? `
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        animation-delay: ${delay}ms;
      ` : ''}
      />
      <path 
        d="M255.97 334.473c22.98-83.115 60.766-164.702 110.592-208.23C344 48.546 302.366 0 256.004 0 209.634 0 168 48.546 145.446 126.242c49.827 43.529 87.552 125.141 110.524 208.231m-77.372-200.346c11.324-38.494 27.682-68.941 46.046-85.734 3.473-3.191 8.875-2.944 12.058.538 3.183 3.473 2.935 8.875-.538 12.049-15.872 14.515-30.882 42.931-41.19 77.961a8.54 8.54 0 0 1-8.183 6.135 8.7 8.7 0 0 1-2.415-.35c-4.523-1.34-7.109-6.076-5.778-10.599"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width={strokeWidth}
        stroke-linecap="round"
        class={animate ? 'wave-path5' : 'static-path5'}
        style={animate ? `
        stroke-dasharray: 1400;
        stroke-dashoffset: 1400;
        animation-delay: ${delay}ms;
      ` : ''}
      />
  </svg>

  {animate && (
    <>
      <style is:inline>
        .wave-wrapper5 {
          position: relative;
          width: 100%;
          height: 100%;
          align-items: end;
          display: flex;
        }

        .wave-path5 {
          opacity: 0;
        }

        .wave-path5.visible {
          opacity: 1;
          animation: drawWave5 3.4s ease-out forwards;
        }

        @keyframes drawWave5 {
          to {
            stroke-dashoffset: 0;
          }
        }
      </style>

      <script>
        function setupWaveObserver() {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  entry.target.querySelectorAll('.wave-path5').forEach((el) => el.classList.add('visible'));
                  observer.unobserve(entry.target);
                }
              });
            },
            { 
              threshold: 0.1,
              rootMargin: '50px'
            }
          );

          document.querySelectorAll('.wave-wrapper5').forEach((wrapper) => {
            if (wrapper && !wrapper.classList.contains('visible')) {
              observer.observe(wrapper);
            }
          });
        }

        // Run immediately
        setupWaveObserver();

        // Run again after page load to catch any dynamically loaded elements
        window.addEventListener('load', setupWaveObserver);

        // Run when Astro view transitions complete
        document.addEventListener('astro:page-load', setupWaveObserver);

      </script>
    </>
  )}
</div>

<style is:global>
  .curvy-wave {
    width: 100%;
    height: 100%;
  }

  .static-wrapper5 {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-path5 {
    opacity: 1;
  }
</style>
