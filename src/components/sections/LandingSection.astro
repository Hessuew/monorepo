---
import Logo from '~/components/Logo.astro';
import { AnimatedGradientText } from '~/components/magicui/animated-gradient-text';
import Button from '~/components/ui/Button.astro';
import GridPattern from '~/components/ui/GridPattern.astro';
---

<div
  class="max-w-[1480px] rotate-180 [--color:var(--orange)] pointer-events-none relative -z-[2] mx-auto h-[50rem] overflow-hidden [mask-image:radial-gradient(ellipse_at_center_center,#000,transparent_70%)] my-[-18.8rem]
      before:absolute before:inset-0 before:h-full before:w-full before:opacity-30 before:[background-image:radial-gradient(circle_at_top_center,var(--color),transparent_70%)]
      after:absolute after:-left-1/2 after:top-1/2 after:aspect-[1/0.7] after:w-[200%] after:rounded-[50%] after:border-t after:border-b after:border-[white] after:bg-page after:[transform:scaleY(-1)] after:[box-shadow:0_0_40px_10px_var(--orange),0_0_40px_10px_var(--orange)_inset]"
>
</div>

<div class="absolute top-0 left-0 w-full">
  <div class="max-w-7xl xl:max-w-[1280px] mx-auto px-4 sm:px-6 xl:px-[24px] pt-4 xl:pt-[16px]">
    <Logo />
  </div>
</div>

<div class="lg:min-h-[100vh] xl:min-h-[80vh]">
  <div class="max-w-7xl xl:max-w-[1280px] mx-auto px-4 sm:px-8 xl:px-[24px]">
    <div class="relative flex overflow-visible pt-10 xl:pt-[40px]">
      <div class="-z-10 absolute -top-40 xl:-top-[160px] -right-[440px]"></div>
      <div class="relative flex flex-col">
        <h1
          class="relative z-30 max-w-[666px] font-title text-[42px] font-semibold leading-[0.9] tracking-tight lg:max-w-[648px] lg:text-[84px] md:max-w-[521px] md:text-[68px] sm:max-w-[400px] xs:text-[52px]"
        >
          <AnimatedGradientText className="tracking-tighter" colorFrom="#ffaa40" colorTo="#1a0024"
            >Custom</AnimatedGradientText
          >
          <span
            class="bg-gradient-to-br from-white from-30% via-[#d5d8f6] via-80% to-[#fdf7fe] bg-clip-text text-transparent"
          >
            websites
            <br />
            for ministries
          </span>
        </h1>

        <p
          class="relative z-30 mt-5 max-w-md xl:max-w-[448px] text-[18px] leading-snug tracking-tight text-grey-90 xl:mt-[16px] lg:mt-4 md:mt-3.5 md:text-[18px] sm:mt-3 sm:text-[15px]"
        >
          <br />
          <!-- Cherubim IT, create yourself a brand and a presence&nbsp;
          <br class="hidden md:block" />
          you can confidently present to the whole world. -->
          Cherubim IT specializes in custom websites for ministries, churches, and faith-based organizations seeking to glorify
          God online with clarity and excellence.
        </p>

        <div class="flex flex-row gap-3 xl:gap-[18px] mt-11 lg:mt-9 md:mt-7 sm:mt-5 xl:mt-[44px]">
          <Button
            href="#customer-cards"
            class="bg-white/5 backdrop-blur-lg hover:bg-white/10 border-0 text-white h-12 xl:h-[48px] w-34 xl:w-[136px] md:px-6 xl:px-[3px] rounded-full text-base xl:text-[16px] xl:leading-[24px] font-semibold"
          >
            Why Cherubim
          </Button>

          <a
            href="#contact"
            class="shiny-cta shiny-cta-orange h-12 xl:h-[48px] items-center justify-center flex sm:pt-1 xl:pt-[4px]"
          >
            <span class="text-base xl:text-[16px] xl:leading-[24px] font-semibold px-4 xl:px-[16px]">Quick Contact</span
            >
          </a>
        </div>
      </div>
    </div>

    <GridPattern fadeDirection="both" fadeHorizontal="none" />

    <div
      class="[--color:var(--violet2)] pointer-events-none relative -z-[2] mx-auto h-[50rem] overflow-hidden [mask-image:radial-gradient(ellipse_at_center_center,#000,transparent_70%)] my-[-18.8rem]
      before:absolute before:inset-0 before:h-full before:w-full before:opacity-30 before:[background-image:radial-gradient(circle_at_top_center,var(--violet2),transparent_70%)]
      after:absolute after:-left-1/2 after:top-1/2 after:aspect-[1/0.7] after:w-[200%] after:rounded-[50%] after:border-t after:border-b after:border-[hsl(var(--border))] after:bg-page after:[transform:scaleY(-1)] after:[box-shadow:0_0_40px_10px_var(--violet2),0_0_40px_10px_var(--violet2)_inset]"
    >
    </div>
  </div>
</div>
