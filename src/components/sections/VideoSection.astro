---
import imgGradient from '~/assets/images/other/gradient.webp';
import prayerChurchLogo from '~/assets/images/siteLogos/prayer-church-website-design-logo.webp';
import urFitChild from '~/assets/images/urfitChild.webp';
import animated_details from '~/assets/videos/animated_details2.mp4';
import beauty_contrasts from '~/assets/videos/beauty_contrasts.mp4';
import hot_twist from '~/assets/videos/hot_twist.mp4';
import testimonials from '~/assets/videos/testimonials.mp4';
import SvgAnimation from '~/components/ui/icons/SvgAnimation';
import SvgFire from '~/components/ui/icons/SvgFire';
import SvgGem from '~/components/ui/icons/SvgGem';
import SvgGift from '~/components/ui/icons/SvgGift';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import VideoCard from '~/components/widgets/VideoCard.astro';

// Define video data for reusability
const videos = [
  {
    videoSrc: hot_twist,
    videoTitle: 'Interactive church website design presenting deep spiritual truths with creativity and engagement.',
    thumbnailSrc: {
      src: urFitChild,
      alt: 'Church website design - Interactive spiritual design',
    },
    title: 'Hot twist',
    description:
      'Our church website design delivers engaging and timeless experiences that present deep spiritual truths through interactivity and creativity. This fresh approach demonstrates how church websites can effectively resonate with both hearts and minds while enhancing digital outreach.',
    icon: SvgFire,
  },
  {
    videoSrc: beauty_contrasts,
    videoTitle:
      'Church website design featuring bold color contrasts of deep blues and rich golds with elegant typography.',
    thumbnailSrc: {
      src: prayerChurchLogo,
      alt: 'Church website design - Prayer Church design example',
    },
    title: 'The beauty of contrasts',
    description:
      'When creating church website design, we craft visually stunning experiences featuring bold contrasts—deep blues, rich golds, and elegant typography. Every element is strategically developed to surprise, impress, and reflect the excellence of church websites that drive engagement and spiritual connection.',
    icon: SvgGem,
  },
  {
    videoSrc: testimonials,
    videoTitle: 'Authentic testimonials showcasing the impact of church website design on outreach and engagement.',
    thumbnailSrc: {
      src: urFitChild,
      alt: 'Church website design - Testimonial showcase',
    },
    title: 'Interesting testimonials',
    description:
      'Our church website design generates testimonials that break the mold—unexpected, authentic, and spiritually rich. Instead of predictable praise, visitors encounter personal stories that inspire and reveal the real-life impact of church websites optimized for outreach and digital evangelism.',
    icon: SvgGift,
  },
  {
    videoSrc: animated_details,
    videoTitle:
      'Church website design with smooth animations making complex spiritual content accessible and engaging.',
    thumbnailSrc: {
      src: urFitChild,
      alt: 'Church website design - Animated design elements',
    },
    title: 'Animated details',
    description:
      'In our church website design, every detail moves with purpose—from fluid animations to carefully timed transitions. Even complex spiritual content becomes accessible and engaging through thoughtful design and modern front-end performance, showcasing how church websites can effectively communicate your message.',
    icon: SvgAnimation,
  },
];
---

<section
  id="videoSection"
  aria-label="Video examples of church website design"
  class="stay-productive relative z-10 pt-40 xl:pt-[160px] lg:pt-32 md:pt-24 sm:pt-16"
>
  <img src={imgGradient.src} alt="" class="w-full h-40 xl:h-[160px]" />
  <div class="bg-white">
    <WidgetWrapper animated={false} containerClass="p-8 py-20 md:p-12 lg:p-20 xl:p-[80px] relative overflow-hidden">
      <div class="text-start text-black pb-7 xl:pb-[28px]">
        <h2 class="text-4xl md:text-7xl xl:text-[60px] font-semibold tracking-tighter">
          Church website design
          <br />
          Optimized for outreach,
          <br />
          built for impact.
        </h2>

        <p
          class="text-[15px] font-normal leading-tight tracking-tight sm:text-[18px] mt-3 xl:mt-[12px] mb-7 xl:mb-[48px]"
        >
          We specialize in church website design that elevates your digital presence through&nbsp;
          <br class="hidden xs:block" />
          SEO-optimized design, mobile-first performance, and authentic spiritual messaging.
        </p>

        <h3 class="text-2xl md:text-4xl xl:text-[36px] font-semibold tracking-tighter text-start text-black">
          Examples of our
          <br />
          church website design
        </h3>
        <p class="text-black text-[15px] font-normal leading-tight tracking-tight sm:text-[18px] mt-3 xl:mt-[12px]">
          Explore how our church website design blends spiritual depth with technical
          <br class="hidden xs:block" />
          excellence to create powerful digital platforms for outreach and community building.
        </p>
      </div>

      <div class="flex flex-col gap-12 lg:gap-16 xl:gap-[64px]">
        <!-- Videos container - top row -->
        <div class="flex flex-col md:flex-row gap-8 md:gap-6 lg:gap-10 xl:gap-[40px]">
          <!-- First video -->
          <div class="w-full md:w-1/2">
            <VideoCard
              video={{
                videoSrc: videos[0].videoSrc,
                videoTitle: videos[0].videoTitle,
                thumbnailSrc: videos[0].thumbnailSrc,
                title: videos[0].title,
                description: videos[0].description,
              }}
            >
              <SvgFire slot="icon" className="w-12 h-12 xl:w-[48px] xl:h-[48px]" />
            </VideoCard>
          </div>

          <!-- Second video -->
          <div class="w-full md:w-1/2">
            <VideoCard video={videos[1]}>
              <SvgGem slot="icon" className="w-12 h-12 xl:w-[48px] xl:h-[48px]" />
            </VideoCard>
          </div>
        </div>

        <!-- Bottom row -->
        <div class="flex flex-col md:flex-row gap-8 md:gap-6 lg:gap-10 xl:gap-[40px]">
          <!-- Third video -->
          <div class="w-full md:w-1/2">
            <VideoCard video={videos[2]}>
              <SvgGift slot="icon" className="w-12 h-12 xl:w-[48px] xl:h-[48px]" />
            </VideoCard>
          </div>

          <!-- Fourth video -->
          <div class="w-full md:w-1/2">
            <VideoCard video={videos[3]}>
              <SvgAnimation slot="icon" className="w-12 h-12 xl:w-[48px] xl:h-[48px]" />
            </VideoCard>
          </div>
        </div>
      </div>
    </WidgetWrapper>
  </div>
</section>
