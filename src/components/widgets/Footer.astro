---
export interface Props {
  theme?: string;
}

const { theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative bottom-0 not-prose']}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl xl:max-w-[1280px] mx-auto pt-20 pb-10 px-4 xl:pt-[80px] xl:pb-[40px] xl:px-[16px] sm:px-6 text-slate-300"
  >
    <div class="text-center">
      <p class="text-[#777] text-base xl:text-[16px] xl:leading-[24px]">
        Made by:
        <span class="text-[#b8b09f] transition-all duration-300 hover:text-[#f95959] no-underline">Cherubim IT</span>
      </p>
    </div>
  </div>
</footer>
