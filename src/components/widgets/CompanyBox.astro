---
import type { ImageMetadata } from 'astro';

interface Props {
  logo: ImageMetadata;
  name: string;
  description1: string;
  description2: string;
}

const { logo, name, description1, description2 } = Astro.props;
---

<div class="company-box flex-none px-[15px] py-2 sm:py-0 sm:mb-5 w-full sm:w-1/3">
  <div
    class="company-box-inner shadow-lg bg-white/80 text-center rounded-xl overflow-hidden transition-all duration-350"
  >
    <div class="company-box-top py-[25px] px-[20px] border-b border-[#dee2e6]">
      <div class="company-logo-wrapper flex flex-row items-center justify-center gap-3">
        <img src={logo.src} alt="urFIT-child logo" class="h-[60px] object-contain rounded" />
        <h3 class="company-name text-black m-0 text-xl xl:text-[24px] xl:leading-[28px] tracking-tight">{name}</h3>
      </div>
    </div>
    <div class="company-box-bottom p-5">
      <span class="text-[15px] leading-[24px] text-[#878898] md:leading-[30px]">
        <div class="flex flex-row gap-1 xl:gap-[1px] justify-center">
          {description1}
          <strong class="text-[#242e45] text-start">
            {description2}
          </strong>
        </div>
      </span>
    </div>
  </div>
</div>
