---
// VideoCard.astro - A component that displays a video with a thumbnail overlay
// Following the Rule: Write concise, technical TypeScript code with accurate examples

interface Props {
  videoSrc: string;
  thumbnailSrc?: { src: string; alt: string };
  title: string;
  description: string;
}

const { videoSrc, title, description } = Astro.props;
---

<div class="w-full rounded-3xl bg-transparent">
  <div class="video-container relative rounded-3xl overflow-hidden">
    <!-- Video element -->
    <video src={videoSrc} muted playsinline class="rounded-3xl w-full"></video>

    <!-- <div class="thumbnail absolute inset-0 transition-opacity duration-300">
      <Image
        class="w-full h-full object-cover rounded-3xl"
        width={700}
        height={400}
        widths={[400, 768]}
        layout="fixed"
        loading="lazy"
        decoding="async"
        style={`object-fit: cover; object-position: center;`}
        {...thumbnailSrc}
      />

      <div class="play-button-overlay absolute inset-0 flex items-center justify-center">
        <div
          class="play-button-circle w-10 h-10 md:w-12 md:h-12 bg-black bg-opacity-40 backdrop-blur-sm rounded-full flex items-center justify-center"
        >
          <svg class="w-10 h-10 md:w-12 md:h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width={2}
              d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
            ></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </div> -->

    <!-- Content below video -->
    <div class="pt-6 pl-4">
      <slot name="icon" />

      <h3
        class="mt-5 font-title text-black max-w-28 text-[20px] leading-none tracking-tighter lg:mt-4 lg:max-w-full lg:text-[28px] md:mt-3.5 sm:mt-2.5 sm:max-w-32 sm:text-[24px]"
      >
        {title}
      </h3>

      <p
        class="mt-3.5 text-black text-[15px] font-medium leading-snug tracking-tighter lg:mt-2.5 md:mt-2 md:leading-tight sm:mt-1 max-w-none sm:max-w-[284px]"
      >
        {description}
      </p>
    </div>
  </div>

  <style>
    .video-container:hover .thumbnail {
      opacity: 0;
    }

    .video-container:focus-within .thumbnail {
      opacity: 0;
    }

    .play-button-overlay {
      pointer-events: none; /* Allows clicks to pass through to the video container */
    }

    .video-container:hover .play-button-overlay {
      opacity: 0;
      transform: scale(1.1);
    }

    .video-container:focus-within .play-button-overlay {
      opacity: 0;
      transform: scale(1.1);
    }

    /* Add a subtle pulse animation to draw attention without being too distracting */
    @keyframes subtle-pulse {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.03);
      }
      100% {
        transform: scale(1);
      }
    }

    .play-button-circle {
      animation: subtle-pulse 3s infinite ease-in-out;
    }

    .video-container:hover .play-button-circle {
      animation: none;
    }
  </style>

  <script>
    // Client-side script to handle video play/pause on hover
    document.addEventListener('DOMContentLoaded', () => {
      const videoContainers = document.querySelectorAll('.video-container');

      videoContainers.forEach((container) => {
        const video = container.querySelector('video');

        if (video) {
          // Play video on hover
          container.addEventListener('mouseenter', () => {
            video.play();
          });

          // Pause video when mouse leaves
          //container.addEventListener('mouseleave', () => {
          //video.pause();
          //});

          // Accessibility: Play video on focus
          container.addEventListener('focusin', () => {
            video.play();
          });

          // Accessibility: Pause video on blur
          // container.addEventListener('focusout', () => {
          //   video.pause();
          // });

          // Make container focusable for keyboard navigation
          container.setAttribute('tabindex', '0');
        }
      });
    });
  </script>
</div>
