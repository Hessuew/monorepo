---
import Dock from '~/components/ui/Dock.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
---

<WidgetWrapper id={'pricing'} animated={false} containerClass={`max-w-7xl mx-auto`}>
  <section class="relative z-10">
    <div class="p-20">
      <h1 class="text-5xl md:text-7xl font-semibold tracking-tighter text-start text-white pb-7">
        Pricing correctly
        <br />
        to create trust.
        <br />
        <p class="text-[15px] font-normal leading-tight tracking-tight sm:text-[18px] mt-3">
          <!-- If the price is too high, it’s out of reach. Too low, and it devalues the product. -->
          <br />
          The right price strikes a balance—where the customer is glad to pay,
          <br />
          and the seller is confident in what they’re offering.

          <br />
          <br />
          These are prices our customers would pick themselves,
          <br />
          based on what they believe the service is worth.
        </p>
      </h1>

      <div class="flex w-full justify-center">
        <Dock />
      </div>
    </div>
  </section>
</WidgetWrapper>
