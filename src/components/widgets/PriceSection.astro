---
import Dock from '~/components/ui/Dock.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
---

<WidgetWrapper id={'pricing'} animated={false} containerClass={`max-w-7xl mx-auto`}>
  <section class="relative z-10">
    <div class="p-20">
      <h1 class="text-5xl md:text-7xl font-semibold tracking-tighter text-start text-white pb-7">
        Transparency creates an environment of trust
        <br />
        <p class="text-[15px] font-normal leading-tight tracking-tight sm:text-[18px] mt-3">
          <br />
          We are here to advance the kingdom of God together.
          <br />
          The price you are glad to pay, and we are confident to offer.
        </p>
      </h1>

      <div class="flex w-full justify-center">
        <Dock />
      </div>
    </div>
  </section>
</WidgetWrapper>
