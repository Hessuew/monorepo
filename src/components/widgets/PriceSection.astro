---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getGradientColor } from '~/utils/getGradientColor';
import { DockDemo } from '../ui/DockDemo';
---

<WidgetWrapper id={'pricing'} animated={false} containerClass={`max-w-7xl mx-auto`}>
  <section class="relative z-10 p-10 sm:p-20">
    <div class="flex w-full justify-center">
      <h1 class="text-4xl md:text-7xl font-semibold tracking-tighter text-start text-white pb-7">
        <span
          class="bg-gradient-to-br from-white from-30% via-[#d5d8f6] via-40% to-black bg-clip-text text-transparent"
        >
          <!-- <span class="bg-gradient-to-br from-black from-2% via-[#d5d8f6] via-34% to-white bg-clip-text text-transparent"> -->
          Open pricing.
          <br />
          Transparent results.
        </span>
        <p class="text-[15px] font-normal leading-tight tracking-tight sm:text-[18px] mt-3">
          <br />
          <!-- We are here to advance the kingdom of God together. -->
          Too high price is out of the reach. Too low devalues the product.
          <br />
          <br />
          The right price strikes a balance—where the customer is glad to pay,
          <br class="hidden md:block" />
          and the seller is confident in what they’re offering.
          <!-- The price you are glad to pay, and we are confident to offer. -->
        </p>
      </h1>
    </div>

    <div class="flex w-full justify-center">
      <DockDemo client:load />
    </div>

    <!-- <div
      class="absolute top-0 left-0 w-full h-full -z-10"
      style={{
        background: `
          radial-gradient(circle at 85% 15%, ${getGradientColor(0.2, 'purple')} 0%, transparent 40%),
          radial-gradient(circle at 15% 85%, ${getGradientColor(0.2, 'purple')} 0%, transparent 40%),
          linear-gradient(to bottom left, ${getGradientColor(0.05, 'purple')} 0%, transparent 100%, ${getGradientColor(0.05, 'purple')} 100%)
        `,
      }}
    >
    </div> -->

    <div
      class="absolute top-0 left-0 w-full h-full -z-10"
      style={{
        background: `
            radial-gradient(circle at 15% 15%, ${getGradientColor(0.2, 'purple')} 0%, transparent 40%),
            radial-gradient(circle at 85% 85%, ${getGradientColor(0.2, 'purple')} 0%, transparent 40%),
            linear-gradient(to bottom right, ${getGradientColor(0.05, 'purple')} 0%, transparent 100%, ${getGradientColor(0.05, 'purple')} 100%)
          `,
      }}
    >
    </div>
  </section>
</WidgetWrapper>
