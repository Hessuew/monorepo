---
import { Icon } from 'astro-icon/components';

const { image, name, nameCompany, description, logo } = Astro.props;
---

<div class="swiper-slide">
  <div
    class="swiper-slide--inner px-6 sm:px-20 lg:px-[15%] flex flex-col sm:flex-row items-center gap-[50px] relative overflow-x-hidden"
  >
    <div class="w-[200px] h-[200px] lg:w-[240px] lg:h-[240px] mb-[30px] flex-shrink-0 rounded-full relative">
      <img src={image.src} alt="" class="w-full h-full object-cover rounded-full" />
      <div
        class="absolute bottom-[30px] left-[-10px] w-[52px] h-[52px] lg:w-[68px] lg:h-[68px] bg-gradient-to-br from-[var(--aw-color-accent)] from-10% to-[var(--aw-color-secondary)] rounded-full flex items-center justify-center shadow-md"
      >
        <Icon name="tabler:quote-filled" class="quote-icon w-[32px] h-[32px] lg:w-[40px] lg:h-[40px] text-white" />
      </div>
    </div>
    <div class="testimonial-detail">
      <div class="flex flex-row items-center gap-3 pb-4 xl:gap-[12px] xl:pb-[16px]">
        <img src={logo.src} alt={nameCompany} class="h-[42px] object-contain rounded" />
        <h3 class="text-black m-0 text-xl xl:text-[24px] xl:leading-[28px] tracking-tight">{nameCompany}</h3>
      </div>

      <p
        class="m-0 text-black text-[15px] leading-[24px] text-left lg:text-[18px] md:leading-[30px] font-medium mb-[5px]"
      >
        {description}
      </p>
      <span class="text-[var(--aw-color-accent)] font-extrabold uppercase text-[12px] lg:text-[15px] leading-normal"
        >{name}
      </span>
    </div>
  </div>
</div>
