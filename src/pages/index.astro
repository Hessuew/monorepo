---
import logo from '~/assets/images/other/logo.webp';
import CustomerCards from '~/components/ui/CustomerCards.astro';
import ContactForm from '~/components/widgets/ContactForm.astro';
import LandingSection from '~/components/widgets/LandingSection.astro';
import PriceSection from '~/components/widgets/PriceSection.astro';
import Principles from '~/components/widgets/Principles.astro';
import TestimonialsCustom from '~/components/widgets/TestimonialsCustom.astro';
import VideoSection from '~/components/widgets/VideoSection.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Cherubim IT | Empower the web community',
  description:
    'Cherubim IT empowers the web community and invites more to build across platforms with powerful tools and frameworks.',
  ignoreTitleTemplate: true,
  canonical: 'https://cherubimit.com',
  openGraph: {
    title: 'Cherubim IT | Empower the web community',
    description:
      'Cherubim IT empowers the web community and invites more to build across platforms with powerful tools and frameworks.',
    type: 'website',
    image: logo,
  },
  twitter: {
    handle: '@CherubimIT',
    site: '@CherubimIT',
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <LandingSection />

  <CustomerCards />

  <VideoSection />

  <TestimonialsCustom />

  <PriceSection />

  <!-- <div style="border-top: 1px solid; border-image: linear-gradient(90deg,#0000 30%,#c8c8c880 50%,#0000 70%) 1;"></div> -->

  <Principles />

  <ContactForm />
</Layout>
