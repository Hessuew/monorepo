---
import logo from '~/assets/images/other/logo.webp';
import ContactSection from '~/components/sections/ContactSection.astro';
import EmailSection from '~/components/sections/EmailSection.astro';
import LandingSection from '~/components/sections/LandingSection.astro';
import PriceSection from '~/components/sections/PriceSection.astro';
import PrinciplesSection from '~/components/sections/PrinciplSection.astro';
import TestimonialsCustom from '~/components/sections/TestimonialsSection.astro';
import VideoSection from '~/components/sections/VideoSection.astro';
import CustomerCards from '~/components/ui/CustomerCards.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Christian Website Design & Branding | Cherubim IT',
  description:
    'Cherubim IT specializes in affordable, faith-based web design and branding for churches, ministries, and Christian organizations. Build your online presence with us today.',
  ignoreTitleTemplate: true,
  canonical: 'https://cherubimit.com',
  openGraph: {
    title: 'Christian Website Design & Branding | Cherubim IT',
    description:
      'Cherubim IT specializes in affordable, faith-based web design and branding for churches, ministries, and Christian organizations. Build your online presence with us today.',
    type: 'website',
    image: logo,
  },
  twitter: {
    handle: '@CherubimIT',
    site: '@CherubimIT',
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <LandingSection />

  <CustomerCards />

  <VideoSection />

  <TestimonialsCustom />

  <PriceSection />

  <EmailSection />

  <!-- <div style="border-top: 1px solid; border-image: linear-gradient(90deg,#0000 30%,#c8c8c880 50%,#0000 70%) 1;"></div> -->

  <PrinciplesSection />

  <ContactSection />
</Layout>
