name = "contact-form"
main = "src/index.tsx"
compatibility_date = "2026-09-01"
compatibility_flags = ["nodejs_compat"]

# Replace these with your own values
[vars]
RESEND_API_KEY = "your-resend-api-key"
RESEND_AUDIENCE_ID = "your-resend-audience-id"

# Store the Turnstile secret with `wrangler secret put CLOUDFLARE_TURNSTILE_SECRET`.

# Cloudflare Rate Limiting API binding used by the contact endpoint.
[[unsafe.bindings]]
name = "CONTACT_FORM_RATELIMIT"
type = "ratelimit"
namespace_id = "1001"

[unsafe.bindings.simple]
limit = 5
period = 60
