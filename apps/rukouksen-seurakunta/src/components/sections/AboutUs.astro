---
import akosua_zoomed_in from '~/assets/images/deacons/rukous_seurakunta_akosua.webp';
// import ahunsi_zoomed2 from '~/assets/images/elders/rukous_seurakunta_ahunsi.webp';
import ama from '~/assets/images/elders/rukous_seurakunta_ama.jpeg';
import mahi from '~/assets/images/elders/rukous_seurakunta_mahi.webp';
import sari from '~/assets/images/elders/rukous_seurakunta_sari.jpeg';
import ImageTextSection from '~/components/widgets/ImageTextSection.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ImageTextSection
  id="meista"
  tagline={t('aboutUs')}
  title={t('workersOfTheGospel')}
  subtitle={t('toYou')}
  classes={{
    headline: {
      subtitle: 'max-w-5xl xl:max-w-[1024px] mx-auto text-base md:text-lg lg:text-xl xl:text-[20px] xl:leading-[28px]',
    },
  }}
  items={[
    // {
    //   title: t('ahunsi'),
    //   name: 'Ahunsimere',
    //   image: {
    //     src: ahunsi_zoomed2,
    //     alt: t('ahunsiImageAlt'),
    //   },
    //   isReversed: true,
    // },
    {
      title: t('mahidere'),
      name: 'Mahidere',
      content: `1) ${t('mahiContent1')}`,
      image: {
        src: mahi,
        alt: t('mahidereImageAlt'),
      },
      isReversed: false,
    },
    {
      title: t('akosua'),
      name: 'Akosua',
      content: `1) ${t('akosuaContent1')} <br /> <br /> 2) ${t('akosuaContent2')} <br /> <br /> 3) ${t('akosuaContent3')}`,
      image: {
        src: akosua_zoomed_in,
        alt: t('akosuaImageAlt'),
      },
      isReversed: true,
    },
    {
      title: t('ama'),
      name: 'Ama',
      image: {
        src: ama,
        alt: t('amaImageAlt'),
      },
    },
    {
      title: t('sari'),
      name: 'Sari',
      image: {
        src: sari,
        alt: t('sariImageAlt'),
      },
    },
  ]}
/>
