{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "contact-form",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "CONTACT_FORM_RATELIMIT",
      "namespace_id": "4322",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
